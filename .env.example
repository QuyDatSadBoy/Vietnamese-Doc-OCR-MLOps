# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=/mlflow

# ── MinIO (S3-compatible model storage) ───────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ── Triton Inference Server ───────────────────────────────────────────────────
TRITON_URL=http://localhost:8000
DET_MODEL_NAME=vn_doc_ocr_det
REC_MODEL_NAME=vn_doc_ocr_rec
TRITON_MODEL_VER=1

# ── Feature Store — Offline (PostgreSQL) ─────────────────────────────────────
OFFLINE_STORE_URL=postgresql://feast:feast@localhost:5432/feast
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=feast

# ── Feature Store — Online (Redis) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka / Flink Streaming ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ocr-images
KAFKA_CONSUMER_GROUP=flink-ocr-processor
